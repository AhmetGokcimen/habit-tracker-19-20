# Copy this file to .env and fill in real values. Never commit .env.

# Port the HTTP server listens on
PORT=3000

# "production" enables the Secure cookie flag (requires HTTPS)
NODE_ENV=development

# Secret used to sign session JWTs. MUST be a long random string (>= 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Session lifetime (minutes)
SESSION_TTL_MINUTES=120

# bcrypt cost factor (10-14 recommended)
BCRYPT_ROUNDS=12

# SQLite database file and upload directory (both git-ignored)
DB_PATH=./data/habit-tracker.db
UPLOAD_DIR=./uploads

# Password used for ALL seeded demo accounts (see README)
SEED_PASSWORD=change-me-Seed-Passw0rd
