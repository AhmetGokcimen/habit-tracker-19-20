# Copy this file to .env and fill in real values. Never commit .env.

# Port the HTTP server listens on (local only; Vercel ignores it)
PORT=3000

# "production" enables the Secure cookie flag (requires HTTPS)
NODE_ENV=development

# Secret used to sign session JWTs. MUST be a long random string (>= 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Session lifetime (minutes)
SESSION_TTL_MINUTES=120

# bcrypt cost factor (10-14 recommended)
BCRYPT_ROUNDS=12

# Accounts that may be created from one IP address (IPv6: /64) per day (1-1000)
REGISTER_DAILY_LIMIT=5

# Proof-photo storage per user, in MB (1-1024)
PHOTO_QUOTA_MB=25
# Proof-photo storage of all users together, in MB; new photos are refused above it
PHOTO_TOTAL_CAP_MB=1024

# Database. Local: a SQLite file (git-ignored). Production: Turso.
#   DATABASE_URL=libsql://<db-name>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:./data/habit-tracker.db
DATABASE_AUTH_TOKEN=

